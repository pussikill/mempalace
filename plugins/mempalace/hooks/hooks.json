{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CODEX_PLUGIN_ROOT}/hooks/mempal-hook.sh\" session-start",
            "timeout": 10,
            "statusMessage": "Starting MemPalace session tracking"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CODEX_PLUGIN_ROOT}/hooks/mempal-hook.sh\" stop",
            "timeout": 60,
            "statusMessage": "Saving MemPalace session context"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CODEX_PLUGIN_ROOT}/hooks/mempal-hook.sh\" precompact",
            "timeout": 120,
            "statusMessage": "Preserving MemPalace context before compaction"
          }
        ]
      }
    ]
  }
}
